<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fabricator.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        x:Class="Fabricator.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="rn-fabricator"
        MinWidth="960"
        MinHeight="640"
        Width="1120"
        Height="720"
        Background="#F5F7FA">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="280,*">
        <Border Grid.Column="0"
                Background="#101828"
                Padding="24">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="rn-fabricator"
                               Foreground="#FFFFFF"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProductTagline}"
                               Foreground="#CBD5E1"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ItemsControl Grid.Row="1"
                              Margin="0,32,0,0"
                              ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    Margin="0,0,0,8"
                                    CornerRadius="6"
                                    Background="#1D2939">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#FFFFFF"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="#98A2B3"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2"
                        Padding="12"
                        CornerRadius="6"
                        Background="#344054">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Workspace discovery"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProjectCountLabel}"
                                   Foreground="#D0D5DD"
                                   FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Padding="32">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding PageTitle}"
                                   Foreground="#101828"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageSubtitle}"
                                   Foreground="#475467"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="12,8"
                            CornerRadius="6"
                            Background="#E0F2FE"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding MilestoneLabel}"
                                   Foreground="#075985"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,28,0,0"
                      RowDefinitions="Auto,Auto,*"
                      RowSpacing="16"
                      IsVisible="{Binding IsWorkspaceView}">
                    <Border Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Workspace root"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WorkspaceStatus}"
                                           Foreground="#475467"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <TextBox Text="{Binding WorkspaceInputPath}"
                                         Watermark="Path to a folder containing mobile projects and templates" />
                                <Button Grid.Column="1"
                                        Padding="16,8"
                                        Command="{Binding LoadWorkspaceCommand}">
                                    <TextBlock Text="Load workspace" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*,Auto,Auto"
                          ColumnSpacing="16">
                        <Border Padding="16"
                                CornerRadius="8"
                                Background="#FFFFFF"
                                BorderBrush="#E4E7EC"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Selected workspace"
                                           Foreground="#475467"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedWorkspacePath}"
                                           Foreground="#101828"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="16"
                                CornerRadius="8"
                                Background="#FFFFFF"
                                BorderBrush="#E4E7EC"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Projects"
                                           Foreground="#475467"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProjectCountLabel}"
                                           Foreground="#101828"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MissingFabricatorStateLabel}"
                                           Foreground="#667085"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="2"
                                Padding="18,10"
                                VerticalAlignment="Stretch"
                                Command="{Binding ShowCreateCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Create Project"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Configure"
                                           FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Padding="18,10"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding HasTemplateCatalog}"
                                Command="{Binding ShowTemplatesCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Templates"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Open catalog"
                                           FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,*,Auto"
                              RowSpacing="14">
                            <Grid ColumnDefinitions="*,Auto"
                                  Margin="0,0,0,14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Mobile projects"
                                               Foreground="#101828"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TemplateCatalogStatus}"
                                               Foreground="#667085"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedProjectLabel}"
                                           Foreground="#475467"
                                           VerticalAlignment="Top" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock Text="{Binding EmptyProjectListMessage}"
                                           Foreground="#667085"
                                           IsVisible="{Binding HasNoProjects}" />

                                <ScrollViewer IsVisible="{Binding HasProjects}">
                                    <ItemsControl ItemsSource="{Binding Projects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,0,8"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Padding="14"
                                                            CornerRadius="6"
                                                            Background="#F9FAFB"
                                                            BorderBrush="#EAECF0"
                                                            BorderThickness="1">
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              RowDefinitions="Auto,Auto,Auto"
                                                              RowSpacing="3">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#101828"
                                                                       FontWeight="SemiBold" />
                                                            <Border Grid.Column="1"
                                                                    Padding="8,4"
                                                                    CornerRadius="4"
                                                                    Background="#EEF2FF">
                                                                <TextBlock Text="{Binding Status}"
                                                                           Foreground="#3730A3"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding Details}"
                                                                       Foreground="#475467"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="2"
                                                                       Grid.ColumnSpan="2"
                                                                       Text="{Binding SignalSummary}"
                                                                       Foreground="#667085"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="16"
                                    CornerRadius="6"
                                    Background="#F9FAFB"
                                    BorderBrush="#EAECF0"
                                    BorderThickness="1"
                                    IsVisible="{Binding HasSelectedProject}">
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SelectedProjectDetail.DisplayName}"
                                                   Foreground="#101828"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedProjectDetail.ProjectPath}"
                                                   Foreground="#667085"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,*,*"
                                          ColumnSpacing="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Overview"
                                                       Foreground="#475467"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.FabricatorStatus}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.PackageName}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.AppliedTemplateCount}"
                                                       Foreground="#101828" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <TextBlock Text="Store Metadata"
                                                       Foreground="#475467"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.AppStoreName}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.PlayStoreName}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.IosBundleIdentifier}"
                                                       Foreground="#101828"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.AndroidApplicationId}"
                                                       Foreground="#101828"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.AppVersion}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.BuildNumber}"
                                                       Foreground="#101828" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Spacing="6">
                                            <TextBlock Text="Statistics"
                                                       Foreground="#475467"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.SourceFileCount}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.ScreenFileCount}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.ComponentFileCount}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.ServiceFileCount}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.UtilityFileCount}"
                                                       Foreground="#101828" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Padding="12"
                                            CornerRadius="6"
                                            Background="#FFFFFF"
                                            BorderBrush="#EAECF0"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="*,*,*"
                                              ColumnSpacing="14">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Agent Memory"
                                                           Foreground="#475467"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentMemoryStatus}"
                                                           Foreground="#101828" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentInstructionsStatus}"
                                                           Foreground="#101828" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentDirectoryStatus}"
                                                           Foreground="#101828" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="6">
                                                <TextBlock Text="Agent Files"
                                                           Foreground="#475467"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentHandoffStatus}"
                                                           Foreground="#101828"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentCurrentFocusStatus}"
                                                           Foreground="#101828" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentOpenQuestionCount}"
                                                           Foreground="#101828" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Spacing="6">
                                                <TextBlock Text="Current Focus"
                                                           Foreground="#475467"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentCurrentFocusSummary}"
                                                           Foreground="#101828"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,28,0,0"
                      RowDefinitions="Auto,*"
                      RowSpacing="16"
                      IsVisible="{Binding IsCreateView}">
                    <Border Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Create Project"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CreateFormStatus}"
                                           Foreground="#475467"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Padding="14,8"
                                    VerticalAlignment="Top"
                                    Command="{Binding ShowWorkspaceCommand}">
                                <TextBlock Text="Back to workspace" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Project details"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Destination, starter, and template source."
                                           Foreground="#667085"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="12"
                                  IsVisible="{Binding IsCreateEditStep}"
                                  IsEnabled="{Binding IsCreateFormEnabled}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Project name"
                                               Foreground="#475467"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CreateProjectName}"
                                             Watermark="MyMobileApp" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Spacing="6">
                                    <TextBlock Text="Output directory"
                                               Foreground="#475467"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CreateOutputDirectory}"
                                             Watermark="Workspace path" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Spacing="6">
                                    <TextBlock Text="Starter template"
                                               Foreground="#475467"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CreateTemplateName}"
                                             Watermark="minimal-splash" />
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Spacing="6">
                                    <TextBlock Text="Template source"
                                               Foreground="#475467"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CreateTemplateSource}"
                                             Watermark="Optional catalog path or template source" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="14"
                                  IsVisible="{Binding IsCreateReviewStep}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Review"
                                               Foreground="#101828"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CreateTargetProjectPath}"
                                               Foreground="#475467"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="18"
                                      RowSpacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Project name"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateProjectName}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="4">
                                        <TextBlock Text="Output directory"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateOutputDirectory}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="4">
                                        <TextBlock Text="Starter template"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateTemplateName}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Spacing="4">
                                        <TextBlock Text="Template source"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateTemplateSource}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Spacing="4">
                                        <TextBlock Text="Confirmation"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateFormStatus}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Execution"
                                                   Foreground="#101828"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CreateExecutionState}"
                                                   Foreground="#475467"
                                                   FontWeight="SemiBold" />
                                    </Grid>

                                    <StackPanel Grid.Row="1"
                                                Spacing="4">
                                        <TextBlock Text="Prepared command"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreatePreparedCommand}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Spacing="4">
                                        <TextBlock Text="Standard output"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateStandardOutput}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3"
                                                Spacing="4">
                                        <TextBlock Text="Standard error"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateStandardError}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4"
                                                Spacing="4">
                                        <TextBlock Text="Result"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateResultSummary}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="10">
                                <Button Grid.Column="1"
                                        Padding="14,8"
                                        IsVisible="{Binding IsCreateEditStep}"
                                        IsEnabled="{Binding IsCreateFormEnabled}"
                                        Command="{Binding ReviewCreateCommand}">
                                    <TextBlock Text="Review create" />
                                </Button>

                                <Button Grid.Column="1"
                                        Padding="14,8"
                                        IsVisible="{Binding IsCreateReviewStep}"
                                        Command="{Binding EditCreateCommand}">
                                    <TextBlock Text="Back to edit" />
                                </Button>

                                <Button Grid.Column="2"
                                        Padding="14,8"
                                        IsVisible="{Binding IsCreateReviewStep}"
                                        Command="{Binding ConfirmCreateCommand}">
                                    <TextBlock Text="Confirm create" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,28,0,0"
                      RowDefinitions="Auto,*"
                      RowSpacing="16"
                      IsVisible="{Binding IsTemplatesView}">
                    <Border Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Templates"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TemplateCatalogStatus}"
                                           Foreground="#475467"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Padding="14,8"
                                    VerticalAlignment="Top"
                                    Command="{Binding ShowWorkspaceCommand}">
                                <TextBlock Text="Back to workspace" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto"
                                  Margin="0,0,0,14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Template catalog"
                                               Foreground="#101828"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TemplateGroupCountLabel}"
                                               Foreground="#667085"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock Text="No templates found in the selected workspace catalog."
                                           Foreground="#667085"
                                           IsVisible="{Binding HasNoTemplateGroups}" />

                                <ScrollViewer IsVisible="{Binding HasTemplateGroups}">
                                    <ItemsControl ItemsSource="{Binding TemplateGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="8"
                                                            Margin="0,0,0,18">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Category}"
                                                                   Foreground="#101828"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding CountLabel}"
                                                                   Foreground="#667085"
                                                                   FontSize="12" />
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Templates}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="14"
                                                                        Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="#F9FAFB"
                                                                        BorderBrush="#EAECF0"
                                                                        BorderThickness="1">
                                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                                                          ColumnDefinitions="*,Auto"
                                                                          RowSpacing="4">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Foreground="#101828"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Version}"
                                                                                   Foreground="#475467"
                                                                                   FontSize="12" />
                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="{Binding Id}"
                                                                                   Foreground="#475467"
                                                                                   FontSize="12" />
                                                                        <TextBlock Grid.Row="2"
                                                                                   Grid.ColumnSpan="2"
                                                                                   Text="{Binding Description}"
                                                                                   Foreground="#667085"
                                                                                   TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Row="3"
                                                                                   Grid.ColumnSpan="2"
                                                                                   Text="{Binding Tags}"
                                                                                   Foreground="#667085"
                                                                                   FontSize="12"
                                                                                   TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>

</Window>

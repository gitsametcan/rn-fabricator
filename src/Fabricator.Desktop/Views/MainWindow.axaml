<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fabricator.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        x:Class="Fabricator.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="rn-fabricator"
        MinWidth="960"
        MinHeight="640"
        Width="1120"
        Height="720"
        Background="#F5F7FA">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="280,*">
        <Border Grid.Column="0"
                Background="#101828"
                Padding="24">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="rn-fabricator"
                               Foreground="#FFFFFF"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProductTagline}"
                               Foreground="#CBD5E1"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,32,0,0"
                            Spacing="8">
                    <Button Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#1D2939"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Command="{Binding ShowWorkspaceCommand}">
                        <StackPanel Spacing="3"
                                    Margin="12">
                            <TextBlock Text="Workspace"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Local project discovery."
                                       Foreground="#CBD5E1"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#1D2939"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            IsVisible="{Binding HasTemplateCatalog}"
                            Command="{Binding ShowTemplatesCommand}">
                        <StackPanel Spacing="3"
                                    Margin="12">
                            <TextBlock Text="Templates"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Grouped reusable template catalog."
                                       Foreground="#CBD5E1"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#1D2939"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Command="{Binding ShowCreateCommand}">
                        <StackPanel Spacing="3"
                                    Margin="12">
                            <TextBlock Text="Create Project"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Create a new mobile app."
                                       Foreground="#CBD5E1"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#1D2939"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Command="{Binding ShowDoctorCommand}">
                        <StackPanel Spacing="3"
                                    Margin="12">
                            <TextBlock Text="Doctor"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Environment diagnostics."
                                       Foreground="#CBD5E1"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#1D2939"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Command="{Binding ShowSetupCommand}">
                        <StackPanel Spacing="3"
                                    Margin="12">
                            <TextBlock Text="Setup"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Guided dependency planning."
                                       Foreground="#CBD5E1"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2"
                        Padding="12"
                        CornerRadius="6"
                        Background="#344054">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Workspace discovery"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProjectCountLabel}"
                                   Foreground="#D0D5DD"
                                   FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Padding="32">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding PageTitle}"
                                   Foreground="#101828"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageSubtitle}"
                                   Foreground="#475467"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="12,8"
                            CornerRadius="6"
                            Background="#E0F2FE"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding MilestoneLabel}"
                                   Foreground="#075985"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,28,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="16"
                      IsVisible="{Binding IsWorkspaceView}">
                    <Border Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Workspace root"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WorkspaceStatus}"
                                           Foreground="#475467"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <TextBox Text="{Binding WorkspaceInputPath}"
                                         Watermark="Path to a folder containing mobile projects and templates" />
                                <Button Grid.Column="1"
                                        Padding="16,8"
                                        Command="{Binding LoadWorkspaceCommand}">
                                    <TextBlock Text="Load workspace" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*,Auto,Auto"
                          ColumnSpacing="16">
                        <Border Padding="16"
                                CornerRadius="8"
                                Background="#FFFFFF"
                                BorderBrush="#E4E7EC"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Selected workspace"
                                           Foreground="#475467"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedWorkspacePath}"
                                           Foreground="#101828"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="16"
                                CornerRadius="8"
                                Background="#FFFFFF"
                                BorderBrush="#E4E7EC"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Projects"
                                           Foreground="#475467"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProjectCountLabel}"
                                           Foreground="#101828"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MissingFabricatorStateLabel}"
                                           Foreground="#667085"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="2"
                                Padding="18,10"
                                VerticalAlignment="Stretch"
                                Background="#0EA5E9"
                                BorderBrush="#0284C7"
                                BorderThickness="1"
                                Command="{Binding ShowCreateCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Create Project"
                                           Foreground="#FFFFFF"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Configure"
                                           Foreground="#E0F2FE"
                                           FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Padding="18,10"
                                VerticalAlignment="Stretch"
                                Background="#FFFFFF"
                                BorderBrush="#0EA5E9"
                                BorderThickness="1"
                                IsVisible="{Binding HasTemplateCatalog}"
                                Command="{Binding ShowTemplatesCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Templates"
                                           Foreground="#075985"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Open catalog"
                                           Foreground="#0369A1"
                                           FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,*,Auto"
                              RowSpacing="14">
                            <Grid ColumnDefinitions="*,Auto"
                                  Margin="0,0,0,14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Mobile projects"
                                               Foreground="#101828"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TemplateCatalogStatus}"
                                               Foreground="#667085"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedProjectLabel}"
                                           Foreground="#475467"
                                           VerticalAlignment="Top" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock Text="{Binding EmptyProjectListMessage}"
                                           Foreground="#667085"
                                           IsVisible="{Binding HasNoProjects}" />

                                <ScrollViewer IsVisible="{Binding HasProjects}">
                                    <ItemsControl ItemsSource="{Binding Projects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,0,8"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Padding="14"
                                                            CornerRadius="6"
                                                            Background="#F9FAFB"
                                                            BorderBrush="#EAECF0"
                                                            BorderThickness="1">
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              RowDefinitions="Auto,Auto,Auto"
                                                              RowSpacing="3">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#101828"
                                                                       FontWeight="SemiBold" />
                                                            <Border Grid.Column="1"
                                                                    Padding="8,4"
                                                                    CornerRadius="4"
                                                                    Background="#EEF2FF">
                                                                <TextBlock Text="{Binding Status}"
                                                                           Foreground="#3730A3"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding Details}"
                                                                       Foreground="#475467"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="2"
                                                                       Grid.ColumnSpan="2"
                                                                       Text="{Binding SignalSummary}"
                                                                       Foreground="#667085"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="16"
                                    CornerRadius="6"
                                    Background="#F9FAFB"
                                    BorderBrush="#EAECF0"
                                    BorderThickness="1"
                                    IsVisible="{Binding HasSelectedProject}">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="12">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding SelectedProjectDetail.DisplayName}"
                                                       Foreground="#101828"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.ProjectPath}"
                                                       Foreground="#667085"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Padding="12,8"
                                                VerticalAlignment="Top"
                                                Background="#FFFFFF"
                                                BorderBrush="#94A3B8"
                                                BorderThickness="1"
                                                Command="{Binding ClearProjectSelectionCommand}">
                                            <TextBlock Text="Back to project list"
                                                       Foreground="#101828" />
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,*,*"
                                          ColumnSpacing="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Overview"
                                                       Foreground="#475467"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.FabricatorStatus}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.PackageName}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.AppliedTemplateCount}"
                                                       Foreground="#101828" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <TextBlock Text="Store Metadata"
                                                       Foreground="#475467"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.AppStoreName}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.PlayStoreName}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.IosBundleIdentifier}"
                                                       Foreground="#101828"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.AndroidApplicationId}"
                                                       Foreground="#101828"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.AppVersion}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.BuildNumber}"
                                                       Foreground="#101828" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Spacing="6">
                                            <TextBlock Text="Statistics"
                                                       Foreground="#475467"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.SourceFileCount}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.ScreenFileCount}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.ComponentFileCount}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.ServiceFileCount}"
                                                       Foreground="#101828" />
                                            <TextBlock Text="{Binding SelectedProjectDetail.UtilityFileCount}"
                                                       Foreground="#101828" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Padding="12"
                                            CornerRadius="6"
                                            Background="#FFFFFF"
                                            BorderBrush="#EAECF0"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="*,*,*"
                                              ColumnSpacing="14">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Agent Memory"
                                                           Foreground="#475467"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentMemoryStatus}"
                                                           Foreground="#101828" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentInstructionsStatus}"
                                                           Foreground="#101828" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentDirectoryStatus}"
                                                           Foreground="#101828" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="6">
                                                <TextBlock Text="Agent Files"
                                                           Foreground="#475467"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentHandoffStatus}"
                                                           Foreground="#101828"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentCurrentFocusStatus}"
                                                           Foreground="#101828" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentOpenQuestionCount}"
                                                           Foreground="#101828" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Spacing="6">
                                                <TextBlock Text="Current Focus"
                                                           Foreground="#475467"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.AgentCurrentFocusSummary}"
                                                           Foreground="#101828"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="3"
                                            Padding="12"
                                            CornerRadius="6"
                                            Background="#FFFFFF"
                                            BorderBrush="#EAECF0"
                                            BorderThickness="1">
                                        <Grid RowDefinitions="Auto,Auto"
                                              RowSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Application Command Center"
                                                           Foreground="#101828"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.CommandCenterStatus}"
                                                           Foreground="#475467"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedProjectDetail.CommandCenterMetadataPath}"
                                                           Foreground="#667085"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Grid Grid.Row="1"
                                                  ColumnDefinitions="*,*,*,*"
                                                  ColumnSpacing="12">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Publishing"
                                                               Foreground="#475467"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SelectedProjectDetail.PublishingSummary}"
                                                               Foreground="#101828"
                                                               TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding SelectedProjectDetail.PublishingReadinessItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      RowDefinitions="Auto,Auto"
                                                                      RowSpacing="2"
                                                                      Margin="0,0,0,6">
                                                                    <TextBlock Text="{Binding Label}"
                                                                               Foreground="#475467"
                                                                               FontSize="12" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Status}"
                                                                               Foreground="#101828"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Row="1"
                                                                               Grid.ColumnSpan="2"
                                                                               Text="{Binding Detail}"
                                                                               Foreground="#667085"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Spacing="6">
                                                    <TextBlock Text="Research"
                                                               Foreground="#475467"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SelectedProjectDetail.ResearchSummary}"
                                                               Foreground="#101828"
                                                               TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding SelectedProjectDetail.ResearchItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      RowDefinitions="Auto,Auto"
                                                                      RowSpacing="2"
                                                                      Margin="0,0,0,6">
                                                                    <TextBlock Text="{Binding Label}"
                                                                               Foreground="#475467"
                                                                               FontSize="12" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Status}"
                                                                               Foreground="#101828"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Row="1"
                                                                               Grid.ColumnSpan="2"
                                                                               Text="{Binding Detail}"
                                                                               Foreground="#667085"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Spacing="6">
                                                    <TextBlock Text="Release"
                                                               Foreground="#475467"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SelectedProjectDetail.ReleaseChecklistSummary}"
                                                               Foreground="#101828"
                                                               TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding SelectedProjectDetail.ReleaseChecklistItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      RowDefinitions="Auto,Auto"
                                                                      RowSpacing="2"
                                                                      Margin="0,0,0,6">
                                                                    <TextBlock Text="{Binding Label}"
                                                                               Foreground="#475467"
                                                                               FontSize="12" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Status}"
                                                                               Foreground="#101828"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Row="1"
                                                                               Grid.ColumnSpan="2"
                                                                               Text="{Binding Detail}"
                                                                               Foreground="#667085"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3"
                                                            Spacing="6">
                                                    <TextBlock Text="Next Actions"
                                                               Foreground="#475467"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SelectedProjectDetail.NextActionsSummary}"
                                                               Foreground="#101828"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="16"
                      IsVisible="{Binding IsCreateView}">
                    <Border Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Create Project"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CreateFormStatus}"
                                           Foreground="#475467"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Padding="14,8"
                                    VerticalAlignment="Top"
                                    Background="#FFFFFF"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1"
                                    Command="{Binding ShowWorkspaceCommand}">
                                <TextBlock Text="Back to workspace"
                                           Foreground="#101828" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Project details"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Destination, starter, and template source."
                                           Foreground="#667085"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="12"
                                  IsVisible="{Binding IsCreateEditStep}"
                                  IsEnabled="{Binding IsCreateFormEnabled}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Project name"
                                               Foreground="#475467"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CreateProjectName}"
                                             Watermark="MyMobileApp" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Spacing="6">
                                    <TextBlock Text="Output directory"
                                               Foreground="#475467"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CreateOutputDirectory}"
                                             Watermark="Workspace path" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Spacing="6">
                                    <TextBlock Text="Starter template"
                                               Foreground="#475467"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CreateTemplateName}"
                                             Watermark="minimal-splash" />
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Spacing="6">
                                    <TextBlock Text="Template source"
                                               Foreground="#475467"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CreateTemplateSource}"
                                             Watermark="Optional catalog path or template source" />
                                </StackPanel>

                                <StackPanel Grid.Row="4"
                                            Spacing="6">
                                    <TextBlock Text="Native dependencies"
                                               Foreground="#475467"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <CheckBox IsChecked="{Binding CreateInstallPods}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Install CocoaPods during create"
                                                       Foreground="#101828" />
                                            <TextBlock Text="Runs React Native CLI with pod install enabled instead of skipping it."
                                                       Foreground="#667085"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="14"
                                  IsVisible="{Binding IsCreateReviewStep}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Review"
                                               Foreground="#101828"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CreateTargetProjectPath}"
                                               Foreground="#475467"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="18"
                                      RowSpacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Project name"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateProjectName}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="4">
                                        <TextBlock Text="Output directory"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateOutputDirectory}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="4">
                                        <TextBlock Text="Starter template"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateTemplateName}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Spacing="4">
                                        <TextBlock Text="Template source"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateTemplateSource}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Spacing="4">
                                        <TextBlock Text="CocoaPods"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateInstallPodsLabel}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3"
                                                Grid.ColumnSpan="2"
                                                Spacing="6">
                                        <TextBlock Text="Readiness"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding CreateReadinessStatus}"
                                                       Foreground="#101828"
                                                       TextWrapping="Wrap" />
                                            <Button Grid.Column="1"
                                                    Padding="12,8"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#94A3B8"
                                                    BorderThickness="1"
                                                    Command="{Binding RunDoctorCommand}">
                                                <TextBlock Text="{Binding CreateReadinessActionLabel}"
                                                           Foreground="#101828" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4"
                                                Grid.ColumnSpan="2"
                                                Spacing="4">
                                        <TextBlock Text="Confirmation"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateFormStatus}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Execution"
                                                   Foreground="#101828"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CreateExecutionState}"
                                                   Foreground="#475467"
                                                   FontWeight="SemiBold" />
                                    </Grid>

                                    <StackPanel Grid.Row="1"
                                                Spacing="4">
                                        <TextBlock Text="Prepared command"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreatePreparedCommand}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Spacing="4">
                                        <TextBlock Text="Standard output"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateStandardOutput}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3"
                                                Spacing="4">
                                        <TextBlock Text="Standard error"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateStandardError}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4"
                                                Spacing="4">
                                        <TextBlock Text="Result"
                                                   Foreground="#475467"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreateResultSummary}"
                                                   Foreground="#101828"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="10">
                                <Button Grid.Column="1"
                                        Padding="14,8"
                                        IsVisible="{Binding IsCreateEditStep}"
                                        IsEnabled="{Binding IsCreateFormEnabled}"
                                        Background="#0EA5E9"
                                        BorderBrush="#0284C7"
                                        BorderThickness="1"
                                        Command="{Binding ReviewCreateCommand}">
                                    <TextBlock Text="Review create"
                                               Foreground="#FFFFFF" />
                                </Button>

                                <Button Grid.Column="1"
                                        Padding="14,8"
                                        IsVisible="{Binding IsCreateReviewStep}"
                                        Background="#FFFFFF"
                                        BorderBrush="#94A3B8"
                                        BorderThickness="1"
                                        Command="{Binding EditCreateCommand}">
                                    <TextBlock Text="Back to edit"
                                               Foreground="#101828" />
                                </Button>

                                <Button Grid.Column="2"
                                        Padding="14,8"
                                        IsVisible="{Binding IsCreateReviewStep}"
                                        Background="#0EA5E9"
                                        BorderBrush="#0284C7"
                                        BorderThickness="1"
                                        Command="{Binding ConfirmCreateCommand}">
                                    <TextBlock Text="Confirm create"
                                               Foreground="#FFFFFF" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="16"
                      IsVisible="{Binding IsTemplatesView}">
                    <Border Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Templates"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TemplateCatalogStatus}"
                                           Foreground="#475467"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Padding="14,8"
                                    VerticalAlignment="Top"
                                    Background="#FFFFFF"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1"
                                    Command="{Binding ShowWorkspaceCommand}">
                                <TextBlock Text="Back to workspace"
                                           Foreground="#101828" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto"
                                  Margin="0,0,0,14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Template catalog"
                                               Foreground="#101828"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TemplateGroupCountLabel}"
                                               Foreground="#667085"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock Text="No templates found in the selected workspace catalog."
                                           Foreground="#667085"
                                           IsVisible="{Binding HasNoTemplateGroups}" />

                                <ScrollViewer IsVisible="{Binding HasTemplateGroups}">
                                    <ItemsControl ItemsSource="{Binding TemplateGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="8"
                                                            Margin="0,0,0,18">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Category}"
                                                                   Foreground="#101828"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding CountLabel}"
                                                                   Foreground="#667085"
                                                                   FontSize="12" />
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Templates}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="14"
                                                                        Margin="0,0,0,8"
                                                                        CornerRadius="6"
                                                                        Background="#F9FAFB"
                                                                        BorderBrush="#EAECF0"
                                                                        BorderThickness="1">
                                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                                                          ColumnDefinitions="*,Auto"
                                                                          RowSpacing="4">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Foreground="#101828"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Version}"
                                                                                   Foreground="#475467"
                                                                                   FontSize="12" />
                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="{Binding Id}"
                                                                                   Foreground="#475467"
                                                                                   FontSize="12" />
                                                                        <TextBlock Grid.Row="2"
                                                                                   Grid.ColumnSpan="2"
                                                                                   Text="{Binding Description}"
                                                                                   Foreground="#667085"
                                                                                   TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Row="3"
                                                                                   Grid.ColumnSpan="2"
                                                                                   Text="{Binding Tags}"
                                                                                   Foreground="#667085"
                                                                                   FontSize="12"
                                                                                   TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="16"
                      IsVisible="{Binding IsDoctorView}">
                    <Border Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Doctor"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DoctorStatus}"
                                           Foreground="#475467"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Padding="14,8"
                                    VerticalAlignment="Top"
                                    Background="#0EA5E9"
                                    BorderBrush="#0284C7"
                                    BorderThickness="1"
                                    Command="{Binding RunDoctorCommand}">
                                <TextBlock Text="Run Doctor"
                                           Foreground="#FFFFFF" />
                            </Button>

                            <Button Grid.Column="2"
                                    Padding="14,8"
                                    VerticalAlignment="Top"
                                    Background="#FFFFFF"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1"
                                    Command="{Binding ShowWorkspaceCommand}">
                                <TextBlock Text="Back to workspace"
                                           Foreground="#101828" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Environment checks"
                                               Foreground="#101828"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DoctorSummaryLabel}"
                                               Foreground="#667085"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="Running"
                                           Foreground="#475467"
                                           FontWeight="SemiBold"
                                           IsVisible="{Binding IsDoctorRunning}" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock Text="Run Doctor to list required mobile development tools."
                                           Foreground="#667085"
                                           IsVisible="{Binding HasNoDoctorResults}" />

                                <ItemsControl ItemsSource="{Binding DoctorGroups}"
                                              IsVisible="{Binding HasDoctorResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="8"
                                                        Margin="0,0,0,18">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#101828"
                                                               FontSize="16"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Summary}"
                                                               Foreground="#667085"
                                                               FontSize="12" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Results}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="14"
                                                                    Margin="0,0,0,8"
                                                                    CornerRadius="6"
                                                                    Background="#F9FAFB"
                                                                    BorderBrush="#EAECF0"
                                                                    BorderThickness="1">
                                                                <Grid RowDefinitions="Auto,Auto,Auto"
                                                                      ColumnDefinitions="Auto,*,Auto"
                                                                      ColumnSpacing="12"
                                                                      RowSpacing="4">
                                                                    <Border Padding="8,4"
                                                                            CornerRadius="4"
                                                                            Background="#EEF2FF">
                                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                                   Foreground="#3730A3"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Name}"
                                                                               Foreground="#101828"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding VersionLabel}"
                                                                               Foreground="#475467"
                                                                               FontSize="12" />
                                                                    <TextBlock Grid.Row="1"
                                                                               Grid.Column="1"
                                                                               Grid.ColumnSpan="2"
                                                                               Text="{Binding Message}"
                                                                               Foreground="#475467"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Row="2"
                                                                               Grid.Column="1"
                                                                               Grid.ColumnSpan="2"
                                                                               Text="{Binding RemediationHint}"
                                                                               Foreground="#667085"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap"
                                                                               IsVisible="{Binding HasRemediationHint}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="16"
                      IsVisible="{Binding IsSetupView}">
                    <Border Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Setup"
                                           Foreground="#101828"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SetupPlanStatus}"
                                           Foreground="#475467"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Padding="14,8"
                                    VerticalAlignment="Top"
                                    Background="#0EA5E9"
                                    BorderBrush="#0284C7"
                                    BorderThickness="1"
                                    Command="{Binding RunSetupPlanCommand}">
                                <TextBlock Text="Build Plan"
                                           Foreground="#FFFFFF" />
                            </Button>

                            <Button Grid.Column="2"
                                    Padding="14,8"
                                    VerticalAlignment="Top"
                                    Background="#FFFFFF"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1"
                                    Command="{Binding ShowWorkspaceCommand}">
                                <TextBlock Text="Back to workspace"
                                           Foreground="#101828" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="20"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Setup plan"
                                               Foreground="#101828"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SetupPlanSummaryLabel}"
                                               Foreground="#667085"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="Running"
                                           Foreground="#475467"
                                           FontWeight="SemiBold"
                                           IsVisible="{Binding IsSetupPlanRunning}" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*,*"
                                  ColumnSpacing="14">
                                <Border Padding="14"
                                        CornerRadius="6"
                                        Background="#F9FAFB"
                                        BorderBrush="#EAECF0"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding SetupPlanPlatformLabel}"
                                               Foreground="#101828"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Grid.Column="1"
                                        Padding="14"
                                        CornerRadius="6"
                                        Background="#F9FAFB"
                                        BorderBrush="#EAECF0"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding SetupPlanPackageManagerLabel}"
                                               Foreground="#101828"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="14"
                                        CornerRadius="6"
                                        Background="#F9FAFB"
                                        BorderBrush="#EAECF0"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding SetupPlanToolchainLabel}"
                                               Foreground="#101828"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2">
                                <TextBlock Text="Build a setup plan to review dependency actions."
                                           Foreground="#667085"
                                           IsVisible="{Binding HasNoSetupPlanItems}" />

                                <ItemsControl ItemsSource="{Binding SetupPlanItems}"
                                              IsVisible="{Binding HasSetupPlanItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="14"
                                                    Margin="0,0,0,8"
                                                    CornerRadius="6"
                                                    Background="#F9FAFB"
                                                    BorderBrush="#EAECF0"
                                                    BorderThickness="1">
                                                <Grid RowDefinitions="Auto,Auto"
                                                      ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="12"
                                                      RowSpacing="8">
                                                    <Border Padding="8,4"
                                                            CornerRadius="4"
                                                            Background="#EEF2FF">
                                                        <TextBlock Text="{Binding KindLabel}"
                                                                   Foreground="#3730A3"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Spacing="3">
                                                        <TextBlock Text="{Binding DependencyName}"
                                                                   Foreground="#101828"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="#475467"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <ItemsControl Grid.Row="1"
                                                                  Grid.Column="1"
                                                                  ItemsSource="{Binding Steps}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="#667085"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,0,0,4" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

</Window>
